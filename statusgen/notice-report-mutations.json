{
  "test": "go test . -run 'HistoricalNotice|NoticeInventory|NoticeSubject|HeldRule|CouldNotCheckLines|ProseLedCommandClosed|SecondSite' -count=1 -timeout 300s",
  "control": {
    "name": "CONTROL \u2014 the report demotes nothing (every notice stays actionable)",
    "file": "notice_report.go",
    "old": "\thistorical = included && !held && (",
    "new": "\thistorical = false && included && !held && ("
  },
  "mutations": [
    {
      "name": "subject is the first brief path ANYWHERE in the line (the pre-fix matcher)",
      "file": "notice_report.go",
      "old": "(\\S+?\\.md)(?::\\d+)?(?::|\\s|$)`)",
      "new": "(?:.*?)(\\S*brief-[0-9]+\\S*?\\.md)`)"
    },
    {
      "name": "held-actionable set emptied (security-review-absent demoted again)",
      "file": "notice_report.go",
      "old": "\t_, held := noticeHeldActionable[f.Rule]\n",
      "new": "\theld := false\n"
    },
    {
      "name": "could-not-check lines lose their NOTICE: prefix",
      "file": "notice_report.go",
      "old": "\"NOTICE: %s %s: %s\\n\", noticeCouldNotCheckTag",
      "new": "\"%.0s%s %s: %s\\n\", \"NOTICE:\", noticeCouldNotCheckTag"
    },
    {
      "name": "a bracket tag is read anywhere in the line, including quoted author text",
      "file": "notice_report.go",
      "old": "noticeTagRe.FindAllStringSubmatch(noticeHead(line), -1)",
      "new": "noticeTagRe.FindAllStringSubmatch(line, -1)"
    },
    {
      "name": "ordering-gate recognised anywhere, not only as the line prefix",
      "file": "notice_report.go",
      "old": "\t\t\tif strings.HasPrefix(line, f.fragment) {",
      "new": "\t\t\tif strings.Contains(line, f.fragment) {"
    },
    {
      "name": "verify-row-portability emitter spells the literal tag again",
      "file": "verifyportability.go",
      "old": "[%s] OS-specific command",
      "new": "[verify-row-portability]%.0s OS-specific command"
    },
    {
      "name": "the closure-baseline could-not-check state is never raised",
      "file": "notice_report.go",
      "old": "\"closure-baseline\"",
      "new": "\"closure-baseline-off\""
    }
  ]
}
